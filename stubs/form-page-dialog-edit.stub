/**
 * The edit form in a dialog. The list page holds `useItemDialog()` and opens it from the row's
 * `actions.edit.dialog`; the server answers the row's starting values from `edit`.
 */
export function Edit{{ subject }}Dialog<TItem extends { id: string }>({
    dialog,
}: {
    dialog: ItemDialog<TItem>;
}) {
    const { t } = useTranslation();
    const target = dialog.target;

    return (
        <FormDialog<{{ subject }}FormValues>
            open={target !== null}
            onOpenChange={dialog.onOpenChange}
            title={t('{{ prefix }}.edit_title')}
            description={t('{{ prefix }}.edit_description')}
            load={target === null ? null : {{ subject }}Controller.edit(target)}
        >
            {(defaults, done) =>
                target !== null && (
                    <{{ subject }}Form
                        action={ {{ subject }}Controller.update.form(target)}
                        defaults={defaults}
                        submitLabel={t('common.save')}
                        onCancel={done}
                        onSuccess={done}
                    />
                )
            }
        </FormDialog>
    );
}
