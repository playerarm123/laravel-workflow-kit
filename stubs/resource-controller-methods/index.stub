    /**
     * Display a listing of the resource.
     *
     * Index{{ model }}Request asks the policy and hands over the Command, built from the raw
     * query string (list-queries.md).
     */
    public function index(Index{{ model }}Request $request, {{ listHandler }} ${{ listVariable }}): Response
    {
        $result = ${{ listVariable }}($request->toCommand());

        return Inertia::render('{{ prefix }}/index', [
            '{{ rows }}' => $result->{{ rows }},
            'sort' => $result->sort,
            'filters' => $result->filters,{{ can }}
        ]);
    }
