{{ imports }}

type Props = {
    /** Wayfinder `{{ subject }}Controller.store.form()` or `.update.form(model)` */
    action: RouteFormDefinition<'post'>;
    defaults: {{ subject }}FormValues;
    submitLabel: string;
    /** Closes the dialog without saving */
    onCancel: () => void;
    /** Closes the dialog once the save went through */
    onSuccess: () => void;
};

/**
 * The form of both dialogs (form-pages.md, "Form dialogs"). The save goes back, so the list keeps
 * its state while it reloads its rows.
 */
export function {{ subject }}Form({
    action,
    defaults,
    submitLabel,
    onCancel,
    onSuccess,
}: Props) {
    const { t } = useTranslation();
{{ state }}
    return (
        <Form
            {...action}
            options={{ preserveScroll: true, preserveState: true }}
            onSuccess={onSuccess}
            className="space-y-6"
        >
            {({ processing, errors }) => (
                <>
                    <div className="grid gap-6 md:grid-cols-2">
{{ fields }}
                    </div>

                    <div className="flex justify-end gap-2">
                        <Button type="button" variant="outline" onClick={onCancel}>
                            {t('common.cancel')}
                        </Button>
                        <Button type="submit" disabled={processing}>
                            {processing && <Spinner />}
                            {submitLabel}
                        </Button>
                    </div>
                </>
            )}
        </Form>
    );
}
