<?php

require_once __DIR__.'/../ListQueryContract.php';

use {{ namespacedAdapter }};
use {{ namespacedCriteria }};
use {{ namespacedModel }};
use {{ namespacedQuery }};
use {{ namespacedSort }};
use App\Application\Concerns\DateRange;

/**
 * Pass seedMatching once SEARCHABLE_COLUMNS names a column, and seedOutOfScope once the list
 * has a scope. Add each filter's and each sort key's own cases below the contract. See
 * list-queries.md, "Tests".
 */
listQueryContract(
    query: {{ query }}::class,
    criteria: fn (array $overrides): {{ criteria }} => new {{ criteria }}(
        sort: {{ sort }}::CreatedAt,
        direction: 'desc',
        search: $overrides['search'] ?? '',
        createdAt: DateRange::fromInput('', ''),
        perPage: $overrides['perPage'] ?? 10,
    ),
    seed: fn (int $count) => {{ model }}::factory()->count($count)->create(),
    break: fn () => breakListQueryColumn('{{ table }}', 'created_at'),
    // seedMatching: fn (string $text) => {{ model }}::factory()->create(['name' => $text]),
);

describe('{{ adapter }}', function () {
    it('is what the read port resolves to', function () {
        expect(app({{ query }}::class))->toBeInstanceOf({{ adapter }}::class);
    });
});
