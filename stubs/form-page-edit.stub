{{ imports }}

type Props = {
    {{ variable }}: { id: string };
    defaults: {{ subject }}FormValues;
};

export default function Edit({ {{ variable }}, defaults }: Props) {
    const { t } = useTranslation();

    setLayoutProps({
        breadcrumbs: [
            { title: t('{{ prefix }}.title'), href: index() },
            { title: t('{{ prefix }}.edit_title'), href: edit({{ variable }}) },
        ],
    });

    return (
        <>
            <Head title={t('{{ prefix }}.edit_title')} />

            <div className="flex flex-col gap-6 p-4">
                <div className="flex flex-wrap items-start justify-between gap-4">
                    <Heading
                        title={t('{{ prefix }}.edit_title')}
                        description={t('{{ prefix }}.edit_description')}
                        variant="small"
                    />

                    <Button variant="outline" asChild>
                        <Link href={{{ back }}}>
                            <ArrowLeft className="size-4" />
                            {t('common.back')}
                        </Link>
                    </Button>
                </div>

                <{{ subject }}Form
                    action={ {{ subject }}Controller.update.form({{ variable }})}
                    defaults={defaults}
                    submitLabel={t('common.save')}
                    cancelHref={{{ back }}}
                />
            </div>
        </>
    );
}
