{{ imports }}

type Props = {
    /** Wayfinder `{{ subject }}Controller.store.form()` or `.update.form(model)` */
    action: RouteFormDefinition<'post'>;
    defaults: {{ subject }}FormValues;
    submitLabel: string;
} & (
    | {
          /** On a page: where cancel goes back to */
          cancelHref: RouteDefinition<'get'>;
          onCancel?: never;
          onSuccess?: never;
      }
    | {
          cancelHref?: never;
          /** In a dialog: closes it without saving */
          onCancel: () => void;
          /** In a dialog: closes it once the save went through */
          onSuccess: () => void;
      }
);

/**
 * The one form of a page and a dialog (form-pages.md, "Form dialogs"): a page passes
 * `cancelHref`, a dialog `onCancel` and `onSuccess`. In a dialog the save goes back, so the list
 * keeps its state while it reloads its rows.
 */
export function {{ subject }}Form({
    action,
    defaults,
    submitLabel,
    cancelHref,
    onCancel,
    onSuccess,
}: Props) {
    const { t } = useTranslation();
{{ state }}
    return (
        <Form
            {...action}
            options={
                cancelHref === undefined
                    ? { preserveScroll: true, preserveState: true }
                    : undefined
            }
            onSuccess={onSuccess}
            className="space-y-6"
        >
            {({ processing, errors }) => {
                const fields = (
                    <div className="grid gap-6 md:grid-cols-2">
{{ fields }}
                    </div>
                );

                return (
                    <>
                        {cancelHref === undefined ? (
                            fields
                        ) : (
                            <Card>
                                <CardHeader>
                                    <CardTitle>{t('{{ prefix }}.form_title')}</CardTitle>
                                </CardHeader>
                                <CardContent>{fields}</CardContent>
                            </Card>
                        )}

                        <div
                            className={
                                cancelHref === undefined
                                    ? 'flex justify-end gap-2'
                                    : 'flex gap-2'
                            }
                        >
                            {cancelHref === undefined && (
                                <Button type="button" variant="outline" onClick={onCancel}>
                                    {t('common.cancel')}
                                </Button>
                            )}
                            <Button type="submit" disabled={processing}>
                                {processing && <Spinner />}
                                {submitLabel}
                            </Button>
                            {cancelHref !== undefined && (
                                <Button variant="outline" asChild>
                                    <Link href={cancelHref}>{t('common.cancel')}</Link>
                                </Button>
                            )}
                        </div>
                    </>
                );
            }}
        </Form>
    );
}
